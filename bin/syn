#!/usr/bin/env python3
"""
Synapse Unified CLI (`syn`)
Usage:
    syn run <file.syn|file.py>          # Run instantly in nano-interpreter
    syn build <file.syn|file.py> [out]  # Compile to native freestanding machine binary
    syn transpile <file.py> [file.syn]  # Convert Python code/library into Synapse S-AST
    syn project <file.syn>              # Decompile Synapse into human-readable Python
    syn bench                           # Run full comparative resource benchmarks
"""

import sys
import os
import subprocess
from tempfile import NamedTemporaryFile

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
PROJECT_ROOT = os.path.dirname(SCRIPT_DIR)
SYNAPSE_CORE = os.path.join(PROJECT_ROOT, "src", "synapse.py")
PY2SYN = os.path.join(PROJECT_ROOT, "src", "py2syn.py")
BENCH = os.path.join(PROJECT_ROOT, "benchmarks", "run_benchmark.py")

def print_help():
    print("""
⚡ Synapse (SYN-IR): AI-Native Ultra-Low-Resource Language Toolchain

Commands:
    syn run <file.syn|file.py>          Run instantly via nano-interpreter
    syn build <file.syn|file.py> [out]  Compile to freestanding native binary (clang -O3)
    syn transpile <file.py> [out.syn]   Convert Python file/library into Synapse IR
    syn project <file.syn>              Project/Decompile Synapse IR to clean Python
    syn bench                           Run live performance & memory benchmarks
    """)

def main():
    if len(sys.argv) < 2 or sys.argv[1] in ('-h', '--help'):
        print_help()
        sys.exit(0)

    cmd = sys.argv[1]

    if cmd == 'bench':
        subprocess.run(["python3", BENCH])
        return

    if len(sys.argv) < 3:
        print(f"Error: Missing file argument for command '{cmd}'")
        print_help()
        sys.exit(1)

    target_file = sys.argv[2]
    out_arg = sys.argv[3] if len(sys.argv) > 3 else None

    # Handle automatic Python -> Synapse transpilation if input is .py
    temp_syn = None
    if target_file.endswith('.py') and cmd in ('run', 'build'):
        with open(target_file, 'r') as pf:
            py_code = pf.read()
        
        sys.path.insert(0, os.path.join(PROJECT_ROOT, "src"))
        from py2syn import transpile
        syn_code = transpile(py_code)
        
        tmp = NamedTemporaryFile('w', suffix='.syn', delete=False)
        tmp.write(syn_code)
        tmp.close()
        temp_syn = tmp.name
        target_file = temp_syn

    try:
        if cmd == 'transpile':
            args = ["python3", PY2SYN, target_file]
            if out_arg:
                args.append(out_arg)
            subprocess.run(args)

        elif cmd == 'run':
            subprocess.run(["python3", SYNAPSE_CORE, "run", target_file])

        elif cmd == 'build':
            out_bin = out_arg or "a.out"
            subprocess.run(["python3", SYNAPSE_CORE, "build", target_file, out_bin])

        elif cmd == 'project':
            subprocess.run(["python3", SYNAPSE_CORE, "project", target_file])

        else:
            print(f"Unknown command: {cmd}")
            print_help()
            sys.exit(1)
    finally:
        if temp_syn and os.path.exists(temp_syn):
            os.remove(temp_syn)

if __name__ == '__main__':
    main()
